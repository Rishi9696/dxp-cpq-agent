# Copy this file to .env.local and fill in the values (never commit .env.local).

# Your Anthropic API key (the SDK reads this automatically).
ANTHROPIC_API_KEY=

# Created once by `npm run setup` (scripts/setup-agent.mjs).
# These point the app at the persisted Managed Agent + Environment.
DXP_AGENT_ID=
DXP_ENVIRONMENT_ID=

# Supabase (server-side only). Project URL + service_role key.
# Dashboard -> Project Settings -> Data API / API keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
