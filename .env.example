# Copy this file to .env.local and fill in the values (never commit .env.local).

# Your Anthropic API key (the SDK reads this automatically).
ANTHROPIC_API_KEY=

# Created once by `node --env-file=.env.local scripts/setup-agent.mjs`.
# These point the app at the persisted Managed Agent + Environment.
DXP_AGENT_ID=
DXP_ENVIRONMENT_ID=
